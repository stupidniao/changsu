load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "shared",
    srcs = glob(["src/**/*.ts"]),
    declaration = True,
    declaration_dir = "lib",
    out_dir = "lib",
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/zod",
    ],
)

npm_package(
    name = "pkg",
    srcs = glob(["src/**/*.ts"]) + [
        ":shared",
        "package.bazel.json",
    ],
    package = "@changsu/shared",
    replace_prefixes = {
        "package.bazel.json": "package.json",
    },
    version = "0.1.0",
    visibility = ["//visibility:public"],
)
